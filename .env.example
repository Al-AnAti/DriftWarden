# ==========================================
# DriftWarden Environment Variables
# ==========================================
# COPY THIS FILE TO .env AND REPLACE PLACEHOLDERS WITH REAL VALUES.

# ------------------------------------------
# 1. GitHub Integration (Reverse-GitOps)
# ------------------------------------------
# A Personal Access Token (PAT) with 'repo' scope to read YAML and open PRs.
GITHUB_PAT=ghp_your_personal_access_token_here

# The repository containing your baseline docker-compose.yml (Format: "owner/repo")
TARGET_REPO=your-github-username/infra-repo

# The target branch that serves as the source of truth (usually main or master)
TARGET_BRANCH=main

# The relative path to the baseline Compose file inside the repository
BASELINE_FILE_PATH=docker-compose.yml

# ------------------------------------------
# 2. Engine & Watcher Configuration
# ------------------------------------------
# Path to local Docker daemon socket
DOCKER_SOCKET_PATH=/var/run/docker.sock

# The explicit Compose namespace to monitor (Opt-In boundary)
# Only containers with the label 'com.docker.compose.project=COMPOSE_NAMESPACE' will be tracked.
COMPOSE_NAMESPACE=finpulse_demo

# Guardrail operating mode: 'observe' (manual UI triggers only) | 'enforce' (autonomous remediation)
WARDEN_MODE=observe

# Quiet-period debounce window (seconds) to prevent event storming on container spin-up
DRIFT_DEBOUNCE_SECONDS=2

# Delay (seconds) before retrying dropped Docker socket connections
DOCKER_EVENT_RECONNECT_DELAY=5

# Grace period (seconds) to suppress drift alerts while adoption PR deploys
ADOPTION_BUFFER_TTL_SECONDS=180

# ------------------------------------------
# 3. Control Plane (FastAPI Web Server)
# ------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Application environment (development | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------
# 4. State Persistence
# ------------------------------------------
# SQLite database URL for buffering pending adoptions and logging events
DATABASE_URL=sqlite:///./warden.db
