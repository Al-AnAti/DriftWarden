# ==========================================
# DriftWarden Environment Variables
# ==========================================
# COPY THIS FILE TO .env AND REPLACE PLACEHOLDERS WITH REAL VALUES.

# ------------------------------------------
# 1. GitHub Integration (Baseline + Reverse-GitOps)
# ------------------------------------------
# A Personal Access Token (PAT) with 'repo' scope to read YAML and open PRs.
GITHUB_PAT=ghp_your_personal_access_token_here

# The repository containing your baseline docker-compose.yml (Format: "owner/repo")
TARGET_REPO=your-github-username/infra-repo

# The target branch that serves as the source of truth (usually main or master)
TARGET_BRANCH=main

# The relative path to the baseline Compose file inside the repository
BASELINE_FILE_PATH=docker-compose.yml

# How often (seconds) the baseline is polled from GitHub. Unchanged files are
# served from the ETag cache and cost no API quota.
BASELINE_POLL_INTERVAL_SECONDS=30

# Load tests/fixtures/docker-compose.test.yaml instead of contacting GitHub.
ALLOW_MOCK_BASELINE=false

# ------------------------------------------
# 2. Engine & Watcher Configuration
# ------------------------------------------
# Path to the local Docker daemon socket (Linux hosts / container deployments).
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Optional explicit Docker base URL (npipe:////./pipe/docker_engine, tcp://host:2375).
# When unset DriftWarden uses docker.from_env(), which honours DOCKER_HOST.
# DOCKER_BASE_URL=

# Fallback Compose namespace when the baseline has no top-level `name:` key.
COMPOSE_NAMESPACE=finpulse_demo

# Guardrail operating mode: 'observe' (manual UI triggers only) | 'enforce' (autonomous remediation)
WARDEN_MODE=observe

# Quiet-period debounce window (seconds) to coalesce Docker events into one reconcile
DRIFT_DEBOUNCE_SECONDS=2

# Delay (seconds) before retrying dropped Docker socket connections
DOCKER_EVENT_RECONNECT_DELAY=5

# Periodic full reconcile sweep (seconds) to catch events missed during reconnects
RECONCILE_SWEEP_INTERVAL_SECONDS=60

# Grace window (seconds) after a baseline change during which enforcement is suppressed
ENFORCEMENT_GRACE_SECONDS=30

# Safety fallback only: buffered adoptions follow their pull request (merged or
# closed). This TTL applies solely to entries whose pull request state cannot be
# determined (no PR, or GitHub unreachable for this long).
ADOPTION_BUFFER_TTL_SECONDS=600

# Comma-separated container name prefixes that are never evaluated
EXCLUDED_NAME_PREFIXES=warden-,driftwarden,k8s_

# ------------------------------------------
# 3. Control Plane (FastAPI Web Server)
# ------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Application environment (development | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Friendly host name shown in the dashboard and audit log (defaults to the machine hostname)
# WARDEN_HOSTNAME=Host-Prod-01

# ------------------------------------------
# 4. State Persistence
# ------------------------------------------
# SQLite database URL for the audit log, pending adoptions and whitelist
DATABASE_URL=sqlite:///./warden.db
