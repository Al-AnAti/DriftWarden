# 1. Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example

# 2. Local State Buffer & Databases
# SQLite data directory mounted into the DriftWarden container by `make start`
data/
# Prevents committing the live SQLite database used for pending_adoptions
*.db
*.db-*
*.sqlite
*.sqlite3
warden.db*
sentinel.db*

# 3. Python Virtual Environments
venv/
.venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# 4. Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 5. Testing & Linting Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# 6. Build Artifacts
build/
dist/
*.egg-info/
.eggs/

